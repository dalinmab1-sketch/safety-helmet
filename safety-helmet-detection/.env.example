# Copy to .env and adjust. Every Config field can be overridden by its UPPERCASE name.
SOURCE=0                      # webcam index, video file path, or rtsp:// URL
MODEL_PATH=models/helmet_model.pt
PERSON_MODEL_PATH=            # optional: separate person model, e.g. yolov8n.pt
PERSON_CONF=0.40
HELMET_CONF=0.50
NO_HELMET_CONF=0.50
DETECT_FLOOR=0.25
DERIVE_NO_HELMET=false        # true if the model only has person + helmet classes
ALERT_ENABLED=true
ALERT_SOUND=true
ALERT_STABLE_FRAMES=15
SNAPSHOTS_ENABLED=false
LOGGING_ENABLED=true
RETENTION_DAYS=30
CAMERA_ID=cam-01
DISPLAY_WIDTH=960
